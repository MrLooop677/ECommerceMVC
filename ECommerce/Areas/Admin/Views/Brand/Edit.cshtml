@using ECommerce.ViewModels
@model UpdateBrandRequest

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Create New Brand</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">

                        <!-- Brand Name -->
                        <div class="mb-3">
                            <label for="Name" class="form-label">Brand Name</label>
                            <input type="text"
                                   class="form-control"
                                   id="Name"
                                  
                                   placeholder="Enter Brand name"
                                   asp-for="Name"/>
                                   <span class="text-danger" asp-validation-for="Name"></span>

                        </div>

                        <!-- Image Upload -->
                        <div class="mb-3">
                            <label for="img" class="form-label">Brand Image</label>
                            <input type="file"
                                   class="form-control"
                                   id="img"
                                  
                                   accept="image/*"
                                   onchange="previewImage(event)"
                                   asp-for="NewImg"
                                   />
                                   <span class="text-danger" asp-validation-for="Img"></span>
                            <!-- Image Preview -->
                            <div class="text-center mt-3">
                                <img id="preview"
                                     src="@(string.IsNullOrEmpty(Model.Img) ? "" : Url.Content("~/images/" + Model.Img))"
                                     alt="Image Preview"
                                     style="max-width: 200px; display:@(string.IsNullOrEmpty(Model?.Img) ? "none" : "block"); border-radius:8px;" />
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control"
                                      id="Description"
                                     asp-for="Description"
                                      rows="3"
                                      placeholder="Enter a brief description">@Model?.Description</textarea>
                                      <span class="text-danger" asp-validation-for="Description"></span>
                        </div>

                        <!-- Status -->
                        <div class="mb-3">
                            <label for="Status" class="form-label">Status</label>
                            <select class="form-select"
                                    id="Status"
                                    name="Status"
                                    aria-label="Brand Status"
                                    required>
                                <option value="" disabled selected>Select the status</option>
                                @if (Model?.Status == true)
                                {
                                    <option value="True" selected>Active</option>
                                    <option value="False">Inactive</option>
                                }
                                else
                                {
                                    <option value="True">Active</option>
                                    <option value="False" selected>Inactive</option>
                                }
                            </select>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid gap-2 pt-2">
                            <button type="submit" class="btn btn-success">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                     class="bi bi-plus-circle-fill me-2" viewBox="0 0 16 16">
                                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.5 4.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 0 0 1 0v-3h3a.5.5 0 0 0 0-1h-3v-3z" />
                                </svg>
                                Create Brand
                            </button>
                        </div>

                        <!-- Back link -->
                        <div class="mt-3 text-center">
                            <a href="/Brand" class="btn btn-outline-secondary btn-sm">Back to Brand List</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

    <script>
        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById("preview");

            // لو المستخدم اختار صورة جديدة
            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;   // اعرض الصورة الجديدة
                    preview.style.display = "block"; // خليها تظهر
                };

                reader.readAsDataURL(input.files[0]); // اقرا الصورة كباينري Base64
            } else {
                // لو المستخدم شال الصورة أو مفيش اختيار
                preview.src = "";
                preview.style.display = "none";
            }
        }
    </script>

                @section Scripts{
 <partial name="_ValidationScriptsPartial" />
}